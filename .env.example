# Xray 镜像（固定版本，支持 linux/amd64 和 linux/arm64）
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.5.9
XRAY_LOG_LEVEL=info

# 本地 SOCKS5 入口
CHAIN_BIND_HOST=127.0.0.1
CHAIN_LOCAL_PORT=1286

# 第一跳：VLESS + REALITY
VLESS_ADDRESS=104.245.103.16
VLESS_PORT=443
VLESS_UUID=REPLACE_WITH_VLESS_UUID
VLESS_ENCRYPTION=none
VLESS_FLOW=xtls-rprx-vision
REALITY_SERVER_NAME=portal.citygrainla.co
REALITY_FINGERPRINT=chrome
REALITY_PUBLIC_KEY=REPLACE_WITH_REALITY_PUBLIC_KEY
REALITY_SHORT_ID=REPLACE_WITH_REALITY_SHORT_ID
REALITY_SPIDER_X=/

# 第二跳/最终出口：美国 VMess 普通 TCP
US_VMESS_ADDRESS=140.82.16.145
US_VMESS_PORT=18868
US_VMESS_UUID=REPLACE_WITH_US_VMESS_UUID
US_VMESS_SECURITY=auto

# 出口验证
EXPECTED_EXIT_COUNTRY=US
EXPECTED_EXIT_IP=
